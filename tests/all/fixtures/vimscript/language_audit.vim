" Vim 9.1 oracle; labels and error codes keep paths and locale out of output.
func Probe(label, expression)
  try
    echo a:label string(eval(a:expression))
  catch
    echo a:label matchstr(v:exception, 'E\d\+')
  endtry
endfunc
