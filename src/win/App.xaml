<Application x:Class="Viem.Windows.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="ms-appx:///Microsoft.UI.Xaml/DensityStyles/Compact.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- WinUI's compact dictionary does not reduce MenuBar's fixed height. -->
      <x:Double x:Key="MenuBarHeight">28</x:Double>
      <Thickness x:Key="MenuBarItemButtonPadding">10,2,10,2</Thickness>
    </ResourceDictionary>
  </Application.Resources>
</Application>
