<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Viem.Windows</RootNamespace>
    <AssemblyName>Viem</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Viem.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Publishing (not merely compiling Release IL) removes startup JIT work
         in both Viem and its managed WinUI/Win2D projections. -->
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RustProfile Condition="'$(Configuration)' == 'Release'">release</RustProfile>
    <RustProfile Condition="'$(RustProfile)' == ''">debug</RustProfile>
    <VimRuntimePython Condition="'$(VimRuntimePython)' == ''">python</VimRuntimePython>
    <VimRuntimeScript>$(MSBuildProjectDirectory)/../../scripts/vim-runtime.py</VimRuntimeScript>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <None Include="../../target/$(RustProfile)/viem_core.dll" Link="viem_core.dll" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Tests/**/*.cs;Blocking/**/*.cs" />
    <Content Include="../../assets/themes/*.json" Link="Resources/themes/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <BundledFontResource Include="../../assets/fonts/**/*" />
    <Content Update="Assets\Viem.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/core/document/syntax/treesitter/*.LICENSE;../../src/core/document/syntax/treesitter/nvim.NOTICES.md"
             Link="Resources/Licenses/nvim-treesitter/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckRustLibrary" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('../../target/$(RustProfile)/viem_core.dll')" Text="Build the Rust core first with scripts/build-win.ps1." />
  </Target>
  <!-- Replace the owned font subtree, including licenses and attribution.
       Publishing without a build also copies directly from the checkout. -->
  <Target Name="PackageBundledFonts" AfterTargets="Build">
    <RemoveDir Directories="$(TargetDir)Resources/fonts" />
    <Copy SourceFiles="@(BundledFontResource)" DestinationFiles="@(BundledFontResource->'$(TargetDir)Resources/fonts/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="PublishBundledFonts" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)Resources/fonts" />
    <Copy SourceFiles="@(BundledFontResource)" DestinationFiles="@(BundledFontResource->'$(PublishDir)Resources/fonts/%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="VerifyBundledVimRuntime" BeforeTargets="PrepareForBuild">
    <Exec Command="&quot;$(VimRuntimePython)&quot; &quot;$(VimRuntimeScript)&quot; verify" />
  </Target>
  <!-- The unpackaged WinUI SDK copies these to build output but does not add
       them to the .NET publish inventory. Retain their resource-relative paths. -->
  <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish" DependsOnTargets="Prep_ComputeProcessXamlFiles">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(GeneratedXamlDest)">
        <RelativePath>$([MSBuild]::MakeRelative('$(TargetDir)', '%(GeneratedXamlDest.Identity)'))</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <!-- Run for direct MSBuild/Visual Studio builds and publishing without a build.
       The packager replaces only Resources/vim and verifies both inventories. -->
  <Target Name="PackageBundledVimRuntime" AfterTargets="Build">
    <Exec Command="&quot;$(VimRuntimePython)&quot; &quot;$(VimRuntimeScript)&quot; package &quot;$(TargetDir)/.&quot;" />
  </Target>
  <Target Name="PublishBundledVimRuntime" AfterTargets="Publish">
    <Exec Command="&quot;$(VimRuntimePython)&quot; &quot;$(VimRuntimeScript)&quot; package &quot;$(PublishDir)/.&quot;" />
  </Target>
</Project>
